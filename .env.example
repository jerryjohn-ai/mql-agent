# Copy to .env and fill in. Never commit .env.

# --- Claude ---------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant...
# anthropic (default) | bedrock | fake (no tokens: wiring check only)
MQL_LLM_PROVIDER=anthropic
MQL_SCREEN_MODEL=claude-haiku-5-5
MQL_SCORING_MODEL=claude-sonnet-5-5

# --- Salesforce: Server A (read) and Server B (write) ---------------------
# Easiest for a Trailhead playground: log in once with the sf CLI
#   sf org login web --alias mql-playground
# and point both servers at that alias. In production these are two
# different integration users with different permission sets.
SFA_ORG_ALIAS=mql-playground
SFB_ORG_ALIAS=mql-playground
# Alternatives (per server prefix SFA_ / SFB_):
#   SFA_INSTANCE_URL=https://xxx.my.salesforce.com  SFA_ACCESS_TOKEN=00D...
#   SFA_USERNAME=...  SFA_PASSWORD=...  SFA_SECURITY_TOKEN=...

# --- Shared only by the router and Server B ------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
MQL_APPROVAL_KEY=change-me

# --- Human review ---------------------------------------------------------
MQL_APPROVERS=jerry

# --- Optional -------------------------------------------------------------
 MQL_READ_SERVER_URL=http://127.0.0.1:8101/mcp
 MQL_WRITE_SERVER_URL=http://127.0.0.1:8102/mcp
# MQL_DATA_DIR=./data
# MQL_FAKE_SALESFORCE=1    # run the servers against servers/fake_org.json instead of a real org
